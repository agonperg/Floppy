<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ProyectoFloppy" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Azul corporativo como color principal -->
        <item name="colorPrimary">@color/azul_floppy</item>
        <item name="colorPrimaryVariant">@color/azul_claro_floppy</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Fondo global (ya tienes @color/background definido como blanco) -->
        <item name="android:windowBackground">@color/gris_fondo_card</item>

        <!-- Status bar azul corporativo, adiós al lila -->
        <item name="android:statusBarColor">@color/azul_floppy</item>
        <!-- Iconos de la status bar en blanco (fondo oscuro) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

    </style>

    <style name="Theme.ProyectoFloppy" parent="Base.Theme.ProyectoFloppy" />
</resources>