<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/gris_fondo_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/lila_suave"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/lila_suave"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivFotoComunidad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/perfil"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLetraComunidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#8A67CE"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="D" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreComunidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/corporativo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Derecho" />

            <TextView
                android:id="@+id/tvUbicacionComunidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#5C7B96"
                android:textSize="12sp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Universidad de Jaén" />

            <TextView
                android:id="@+id/tvUltimoMensaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#85919D"
                android:textSize="13sp"
                android:textStyle="italic"
                tools:text="Último mensaje: ¡Bienvenidos al..." />
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <ImageButton
            android:id="@+id/btnAbandonar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/mas"
            android:rotation="45"
            app:tint="#D32F2F" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>